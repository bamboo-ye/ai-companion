{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/events/skill-run-succeeded.v1.schema.json",
  "title": "skill.run.succeeded.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "user_id", "skill_name", "skill_version"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "format": "uuid" },
    "skill_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "skill_version": { "type": "string", "minLength": 1, "maxLength": 32 }
  }
}
