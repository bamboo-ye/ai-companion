{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/agent-direct-canary-report.v1.schema.json",
  "title": "Agent direct Canary report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "decision", "source", "summary", "cases", "violations"],
  "properties": {
    "schema_version": {"const": "agent-direct-canary-report-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["pass", "fail"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_version", "baseline_sha256", "suite_version", "suite_sha256"],
      "properties": {
        "baseline_version": {"const": "agent-direct-canary-baseline-v1"},
        "baseline_sha256": {"$ref": "#/$defs/digest"},
        "suite_version": {"const": "agent-direct-canary-suite-v1"},
        "suite_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases", "completed", "assistant_messages", "assistant_delivery_violations", "direct_runs", "direct_rate",
        "single_model_call_runs", "single_model_call_rate", "quality_passed_runs",
        "quality_pass_rate", "content_passed_runs", "content_pass_rate",
        "repair_attempted_runs", "repair_succeeded_runs", "repair_success_rate",
        "deterministic_repairs", "rewrite_runs", "response_quality_failures",
        "duplicate_violations", "planned_runs", "tool_actions", "model_calls",
        "duration_p95_ms", "duration_max_ms", "repair_probe_passed"
      ],
      "properties": {
        "cases": {"type": "integer", "minimum": 1, "maximum": 20},
        "completed": {"type": "integer", "minimum": 0, "maximum": 20},
        "assistant_messages": {"type": "integer", "minimum": 0},
        "assistant_delivery_violations": {"type": "integer", "minimum": 0, "maximum": 20},
        "direct_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "direct_rate": {"$ref": "#/$defs/rate"},
        "single_model_call_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "single_model_call_rate": {"$ref": "#/$defs/rate"},
        "quality_passed_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "quality_pass_rate": {"$ref": "#/$defs/rate"},
        "content_passed_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "content_pass_rate": {"$ref": "#/$defs/rate"},
        "repair_attempted_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "repair_succeeded_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "repair_success_rate": {"$ref": "#/$defs/rate"},
        "deterministic_repairs": {"type": "integer", "minimum": 0},
        "rewrite_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "response_quality_failures": {"type": "integer", "minimum": 0, "maximum": 20},
        "duplicate_violations": {"type": "integer", "minimum": 0},
        "planned_runs": {"type": "integer", "minimum": 0, "maximum": 20},
        "tool_actions": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "duration_p95_ms": {"type": "number", "minimum": 0},
        "duration_max_ms": {"type": "integer", "minimum": 0},
        "repair_probe_passed": {"type": "boolean"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "status", "execution_mode", "outcome", "model_calls", "duration_ms",
          "assistant_messages", "quality_passed", "content_passed", "deterministic_repairs", "rewrite_attempts",
          "repair_attempted", "repair_succeeded", "duplicate_violations", "planned",
          "tool_actions", "sentence_count"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "status": {"enum": ["completed", "failed", "cancelled", "timed_out", "waiting_approval", "waiting_tool"]},
          "execution_mode": {"enum": ["direct", "single_action", "agentic"]},
          "outcome": {"type": "string"},
          "model_calls": {"type": "integer", "minimum": 0},
          "duration_ms": {"type": "integer", "minimum": 0},
          "assistant_messages": {"type": "integer", "minimum": 0},
          "quality_passed": {"type": "boolean"},
          "content_passed": {"type": "boolean"},
          "deterministic_repairs": {"type": "integer", "minimum": 0},
          "rewrite_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
          "repair_attempted": {"type": "boolean"},
          "repair_succeeded": {"type": "boolean"},
          "duplicate_violations": {"type": "integer", "minimum": 0},
          "planned": {"type": "boolean"},
          "tool_actions": {"type": "integer", "minimum": 0},
          "sentence_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "expected", "actual"],
        "properties": {
          "code": {"enum": ["minimum_not_met", "direct_canary_regression", "repair_probe_failed"]},
          "path": {"type": "string", "pattern": "^/summary/"},
          "expected": {"type": "string"},
          "actual": {}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
