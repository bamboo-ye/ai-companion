{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/direct-traffic-preproduction-drill-attestation.v1.schema.json",
  "title": "Direct traffic preproduction drill attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "created_at", "expires_at", "decision", "mode", "environment_sha256", "provider_instance_sha256", "namespace_sha256", "observer_instance_sha256", "report_sha256", "key_id", "algorithm", "signature"],
  "properties": {
    "schema_version": {"const": "agent-direct-traffic-preproduction-drill-attestation-v1"},
    "attestation_id": {"type": "string", "pattern": "^direct-traffic-preproduction-drill-attestation-[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "decision": {"const": "pass"},
    "mode": {"enum": ["local-contract-simulation", "live-read-only-probe"]},
    "environment_sha256": {"$ref": "#/$defs/digest"},
    "provider_instance_sha256": {"$ref": "#/$defs/digest"},
    "namespace_sha256": {"$ref": "#/$defs/digest"},
    "observer_instance_sha256": {"$ref": "#/$defs/digest"},
    "report_sha256": {"$ref": "#/$defs/digest"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "algorithm": {"const": "hmac-sha256"},
    "signature": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
