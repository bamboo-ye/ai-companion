{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/direct-traffic-production-state.v1.schema.json",
  "title": "Direct traffic production state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_instance_sha256", "environment_sha256", "namespace_sha256", "current_traffic_percent", "revision", "operations", "history_chain_sha256", "observed_at"],
  "properties": {
    "schema_version": {"const": "agent-direct-traffic-production-state-v1"},
    "provider_instance_sha256": {"$ref": "#/$defs/digest"},
    "environment_sha256": {"$ref": "#/$defs/digest"},
    "namespace_sha256": {"$ref": "#/$defs/digest"},
    "current_traffic_percent": {"enum": [0, 5]},
    "revision": {"type": "integer", "minimum": 0, "maximum": 1},
    "operations": {"type": "integer", "minimum": 0, "maximum": 1},
    "history_chain_sha256": {"$ref": "#/$defs/digest"},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
