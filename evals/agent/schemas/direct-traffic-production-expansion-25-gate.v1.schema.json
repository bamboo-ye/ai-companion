{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/direct-traffic-production-expansion-25-gate.v1.schema.json",
  "title": "Direct traffic production 10%-to-25% Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "generated_at", "decision", "environment_sha256", "provider_instance_sha256", "namespace_sha256", "observer_instance_sha256", "current_traffic_percent", "target_traffic_percent", "health_window_seconds", "minimum_health_window_seconds", "source", "violations"],
  "properties": {
    "schema_version": {"const": "agent-direct-traffic-production-expansion-25-gate-v1"},
    "gate_id": {"type": "string", "pattern": "^direct-traffic-production-expansion-25-gate-[0-9a-f]{32}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["pass", "hold"]},
    "environment_sha256": {"$ref": "#/$defs/digest"},
    "provider_instance_sha256": {"$ref": "#/$defs/digest"},
    "namespace_sha256": {"$ref": "#/$defs/digest"},
    "observer_instance_sha256": {"$ref": "#/$defs/digest"},
    "current_traffic_percent": {"const": 10},
    "target_traffic_percent": {"const": 25},
    "health_window_seconds": {"type": "integer", "minimum": 0},
    "minimum_health_window_seconds": {"type": "integer", "minimum": 60},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollout_attestation_sha256", "rollout_report_sha256", "adapter_certification_sha256", "shadow_attestation_sha256", "shadow_gate_report_sha256", "prior_expansion_receipt_sha256"],
      "properties": {
        "rollout_attestation_sha256": {"$ref": "#/$defs/digest"},
        "rollout_report_sha256": {"$ref": "#/$defs/digest"},
        "adapter_certification_sha256": {"$ref": "#/$defs/digest"},
        "shadow_attestation_sha256": {"$ref": "#/$defs/digest"},
        "shadow_gate_report_sha256": {"$ref": "#/$defs/digest"},
        "prior_expansion_receipt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "violations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
