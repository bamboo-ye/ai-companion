{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/direct-traffic-preproduction-execution.v1.schema.json",
  "title": "Direct traffic preproduction execution envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace_sha256", "rollout_request", "rollout_attestation", "adapter_certification", "adapter_certification_sha256", "shadow_attestation", "shadow_attestation_sha256", "expected_state", "request_sha256"],
  "properties": {
    "schema_version": {"const": "agent-direct-traffic-preproduction-execution-v1"},
    "namespace_sha256": {"$ref": "#/$defs/digest"},
    "rollout_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation_id", "idempotency_key", "environment_sha256", "provider_instance_sha256", "attestation_id", "attestation_sha256", "history_chain_sha256", "key_id", "decision_id", "decision", "expected_traffic_percent", "target_traffic_percent", "expected_revision"],
      "properties": {
        "schema_version": {"const": "agent-direct-traffic-request-v1"},
        "operation_id": {"type": "string", "pattern": "^direct-traffic-op-[0-9a-f]{32}$"},
        "idempotency_key": {"$ref": "#/$defs/digest"},
        "environment_sha256": {"$ref": "#/$defs/digest"},
        "provider_instance_sha256": {"$ref": "#/$defs/digest"},
        "attestation_id": {"type": "string", "pattern": "^direct-rollout-attestation-[0-9a-f]{32}$"},
        "attestation_sha256": {"$ref": "#/$defs/digest"},
        "history_chain_sha256": {"$ref": "#/$defs/digest"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "decision_id": {"type": "string", "pattern": "^direct-rollout-[0-9a-f]{32}$"},
        "decision": {"enum": ["expand", "hold", "rollback", "disable"]},
        "expected_traffic_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "target_traffic_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "expected_revision": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    },
    "rollout_attestation": {"$ref": "direct-rollout-attestation.v1.schema.json"},
    "adapter_certification": {"$ref": "direct-traffic-adapter-certification.v1.schema.json"},
    "adapter_certification_sha256": {"$ref": "#/$defs/digest"},
    "shadow_attestation": {"$ref": "direct-traffic-shadow-attestation.v1.schema.json"},
    "shadow_attestation_sha256": {"$ref": "#/$defs/digest"},
    "expected_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_traffic_percent", "revision", "operations", "history_chain_sha256"],
      "properties": {
        "current_traffic_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "revision": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "operations": {"type": "integer", "minimum": 0, "maximum": 100000},
        "history_chain_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "request_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
