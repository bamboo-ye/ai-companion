{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/direct-traffic-production-emergency-gate.v1.schema.json",
  "title": "Direct traffic production emergency Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "generated_at", "decision", "incident_id", "authorized_by", "rollout_decision", "environment_sha256", "provider_instance_sha256", "namespace_sha256", "current_traffic_percent", "target_traffic_percent", "source", "violations"],
  "properties": {
    "schema_version": {"const": "agent-direct-traffic-production-emergency-gate-v1"},
    "gate_id": {"type": "string", "pattern": "^direct-traffic-production-emergency-gate-[0-9a-f]{32}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["pass", "hold"]},
    "incident_id": {"type": "string", "pattern": "^INC-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "authorized_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{2,127}$"},
    "rollout_decision": {"enum": ["rollback", "disable"]},
    "environment_sha256": {"$ref": "#/$defs/digest"},
    "provider_instance_sha256": {"$ref": "#/$defs/digest"},
    "namespace_sha256": {"$ref": "#/$defs/digest"},
    "current_traffic_percent": {"const": 5},
    "target_traffic_percent": {"const": 0},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollout_attestation_sha256", "adapter_certification_sha256", "activation_receipt_sha256"],
      "properties": {
        "rollout_attestation_sha256": {"$ref": "#/$defs/digest"},
        "adapter_certification_sha256": {"$ref": "#/$defs/digest"},
        "activation_receipt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "violations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
