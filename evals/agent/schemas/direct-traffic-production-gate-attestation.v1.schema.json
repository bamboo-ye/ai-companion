{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/direct-traffic-production-gate-attestation.v1.schema.json",
  "title": "Direct traffic production Gate attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "created_at", "expires_at", "gate_id", "decision", "environment_sha256", "provider_instance_sha256", "namespace_sha256", "observer_instance_sha256", "current_traffic_percent", "target_traffic_percent", "gate_report_sha256", "adapter_certification_sha256", "shadow_attestation_sha256", "rollout_attestation_sha256", "key_id", "algorithm", "signature"],
  "properties": {
    "schema_version": {"const": "agent-direct-traffic-production-gate-attestation-v1"},
    "attestation_id": {"type": "string", "pattern": "^direct-traffic-production-gate-attestation-[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "gate_id": {"type": "string", "pattern": "^direct-traffic-production-gate-[0-9a-f]{32}$"},
    "decision": {"const": "pass"},
    "environment_sha256": {"$ref": "#/$defs/digest"},
    "provider_instance_sha256": {"$ref": "#/$defs/digest"},
    "namespace_sha256": {"$ref": "#/$defs/digest"},
    "observer_instance_sha256": {"$ref": "#/$defs/digest"},
    "current_traffic_percent": {"const": 0},
    "target_traffic_percent": {"const": 5},
    "gate_report_sha256": {"$ref": "#/$defs/digest"},
    "adapter_certification_sha256": {"$ref": "#/$defs/digest"},
    "shadow_attestation_sha256": {"$ref": "#/$defs/digest"},
    "rollout_attestation_sha256": {"$ref": "#/$defs/digest"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "algorithm": {"const": "hmac-sha256"},
    "signature": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
