{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/agent-direct-rollout-attestation.v1.schema.json",
  "title": "Agent direct rollout attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "created_at", "expires_at", "decision_id",
    "decision", "current_traffic_percent", "target_traffic_percent", "environment_sha256",
    "report_sha256", "history_chain_sha256", "key_id", "algorithm", "signature"
  ],
  "properties": {
    "schema_version": {"const": "agent-direct-rollout-attestation-v1"},
    "attestation_id": {"type": "string", "pattern": "^direct-rollout-attestation-[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "decision_id": {"type": "string", "pattern": "^direct-rollout-[0-9a-f]{32}$"},
    "decision": {"enum": ["expand", "hold", "rollback", "disable"]},
    "current_traffic_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "target_traffic_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "environment_sha256": {"$ref": "#/$defs/digest"},
    "report_sha256": {"$ref": "#/$defs/digest"},
    "history_chain_sha256": {"$ref": "#/$defs/digest"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "algorithm": {"const": "hmac-sha256"},
    "signature": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
