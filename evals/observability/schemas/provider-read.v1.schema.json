{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/provider-read.v1.schema.json",
  "title": "Read-only provider deployment response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "status",
    "external_operation_id",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "observability-provider-read-v1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["accepted", "completed", "failed"]
    },
    "external_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
