{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/observability-canary-command.v1.schema.json",
  "title": "Observability canary command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "command",
    "timeout_seconds",
    "stabilization_seconds"
  ],
  "properties": {
    "schema_version": {"const": "observability-canary-command-v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 1800},
    "stabilization_seconds": {"type": "number", "minimum": 0, "maximum": 300}
  }
}
