{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion.local/schemas/observability-deployment-authorization.v1.schema.json",
  "title": "Observability deployment authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "scope",
    "deployment_id",
    "run_id",
    "decision",
    "key_id",
    "attestation_sha256",
    "gate_report_sha256",
    "idempotency_key",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "observability-deployment-authorization-v1"},
    "authorization_id": {
      "type": "string",
      "pattern": "^auth-[0-9a-f]{32}$"
    },
    "scope": {"const": "release-promotion"},
    "deployment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "decision": {"const": "promote"},
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
