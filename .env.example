APP_ENV=development
# Override with a reachable Docker Hub mirror when direct registry access is unavailable.
DOCKER_BASE_REGISTRY=docker.io/library
LOG_LEVEL=info
API_HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
# Production must use an https:// origin; localhost is development-only.
WEB_ORIGIN=http://localhost:3000
AUTH_TOKEN_SECRET=development-only-change-me
# Internal LangGraph Worker -> Go Tool Gateway authentication. Keep these
# server-side only; never expose them through NEXT_PUBLIC_* variables.
AGENT_GATEWAY_TOKEN=development-agent-gateway-token
AGENT_CONFIRMATION_SECRET=development-agent-confirmation-secret
AGENT_CONFIRMATION_TTL=15m
AGENT_GATEWAY_URL=http://api:8080
AGENT_GATEWAY_TIMEOUT_SECONDS=10
AGENT_KAFKA_CONSUMER_GROUP=ai-companion-agent-v1
# Agent Worker liveness/readiness and low-cardinality Prometheus metrics.
AGENT_METRICS_ADDR=:9467
AGENT_METRICS_PORT=9467
AGENT_WORKER_LEASE_DURATION=14m
# Database lease polling is the default dispatch path; Kafka mode switches to
# the lower-frequency KAFKA_RECONCILE_INTERVAL recovery sweep.
AGENT_WORKER_POLL_INTERVAL=1s
AGENT_WORKER_RETRY_DELAY=30s
# Retryable runtime failures use bounded exponential backoff. Retry-After on
# HTTP 429/503 takes precedence; jitter is deterministic per run and attempt.
AGENT_WORKER_RETRY_MAX_DELAY=2m
AGENT_WORKER_RETRY_JITTER_PERCENT=20
AGENT_WORKER_MAX_ATTEMPTS=3
AGENT_WORKER_CONCURRENCY=4
AGENT_DISPATCH_QUEUE_SIZE=32
# Bounds LangGraph model fan-out inside one Python process; valid range: 1-4.
AGENT_MODEL_FANOUT_CONCURRENCY=3
# Larger independent Composer source shards reduce model-call count; overlap is added separately.
AGENT_COMPOSER_SOURCE_BATCH_MAX_TOKENS=2000
AGENT_COMPOSER_SOURCE_BATCH_MAX_CHARS=12000
AGENT_COMPOSER_NARRATIVE_BATCH_MAX_CHARS=12000
# Private 0600 JSON cache for exact retries; blank directory uses the process temp directory.
WORKER_RESULT_CACHE_ENABLED=true
WORKER_RESULT_CACHE_DIR=
WORKER_RESULT_CACHE_TTL_SECONDS=1800
WORKER_RESULT_CACHE_MAX_ENTRIES=128
WORKER_RESULT_CACHE_MAX_BYTES=67108864
# Reuse one Python runtime per execution slot; set false for process-per-run rollback.
AGENT_PYTHON_POOL_ENABLED=true
# Complete one runtime handshake before accepting traffic; set 0 to disable startup warmup.
AGENT_PYTHON_POOL_WARM_SIZE=1
AGENT_WORKER_TIMEOUT=12m
AGENT_RUN_TIMEOUT=15m
AGENT_CONTROL_POLL_INTERVAL=500ms
# Comma-separated module cutover. Keep empty until Agent resume smoke passes.
AGENT_CHAT_MODULES=companion,life,work
OPERATOR_TOKEN=development-operator-token
# Production requires OPERATOR_MFA_REQUIRED=true and should pre-provision an admin operator account before disabling legacy bootstrap.
OPERATOR_MFA_REQUIRED=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

MYSQL_DATABASE=ai_companion
MYSQL_USER=ai_companion
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MYSQL_DSN="ai_companion:change-me@tcp(127.0.0.1:3306)/ai_companion?charset=utf8mb4&parseTime=true&loc=UTC"

# API and Worker use PostgreSQL by default. Set mysql only during the explicit
# rollback window; memory is development-only and is not shared across services.
APP_DATABASE_DRIVER=postgres
POSTGRES_DB=ai_companion
POSTGRES_USER=ai_companion
POSTGRES_PASSWORD=change-postgres-me
POSTGRES_DSN="postgres://ai_companion:change-postgres-me@127.0.0.1:5432/ai_companion?sslmode=disable"
LANGGRAPH_STRICT_MSGPACK=true
LANGGRAPH_POSTGRES_DSN="postgres://ai_companion:change-postgres-me@127.0.0.1:5432/ai_companion?sslmode=disable&options=-csearch_path%3Dlanggraph%2Cpublic"

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
PRESENCE_TTL=24h
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW=1m
CONTEXT_RECENT_TOKEN_BUDGET=6000
CONTEXT_SUMMARY_TOKEN_BUDGET=1200
# Optional horizontal-scale transport. The default database dispatcher does
# not require Kafka. To scale across many Worker replicas, set both values and
# start the Compose kafka-scale profile.
KAFKA_ENABLED=false
KAFKA_BROKERS=
KAFKA_CONSUMER_GROUP=ai-companion-background-v1
KAFKA_RECONCILE_INTERVAL=30s
OUTBOX_RELAY_POLL_INTERVAL=500ms
OUTBOX_RELAY_LEASE_DURATION=30s
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_MAX_ATTEMPTS=8
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_companion_document_chunks_v1
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=ai-companion
MINIO_SECRET_KEY=change-minio-me
MINIO_BUCKET=ai-companion
DOCUMENT_STORAGE_DIR=.data/files
DOCUMENT_MAX_UPLOAD_BYTES=20971520
DOCUMENT_WORKER_POLL_INTERVAL=1s
PYTHON_EXECUTABLE=workers/python/.venv/bin/python
PYTHON_WORKER_PATH=workers/python/src
PDF_PARSER_BACKEND=auto
PDF_TOKEN_ENCODING=o200k_base
SPREADSHEET_EXECUTABLE=workers/python/.venv/bin/python
SPREADSHEET_WORKER_PATH=workers/python/src/ai_companion_worker/ledger_export.py
SKILL_STORAGE_DIR=.data/skill-files
LEDGER_STORAGE_DIR=.data/ledger-exports
SKILL_WORKER_ENABLED=true
SKILL_WORKER_POLL_INTERVAL=1s
SKILL_WORKER_LEASE_DURATION=2m
SKILL_WORKER_RENEW_INTERVAL=30s
RELIABILITY_POLL_INTERVAL=10s
NOTIFICATION_SCHEDULER_INTERVAL=1s
# Operator-owned stdio servers only. Commands must be absolute paths and tools must be explicitly allowlisted.
MCP_STDIO_SERVERS_JSON=[]

# Keep development mode until the OpenRouter key, privacy policy, and budget are approved.
# Production OpenRouter profile (API key must stay in local .env or a secret manager):
# MODEL_PROVIDER=openrouter
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=deepseek/deepseek-v4-flash-0731
# MODEL_FALLBACK_NAMES=openai/gpt-5-mini
# MODEL_ROUTER_NAME=deepseek/deepseek-v4-flash-0731
# MODEL_ROUTER_FALLBACK_NAMES=openai/gpt-5-nano
# MODEL_COMPOSER_NAME=deepseek/deepseek-v4-flash-0731
# MODEL_COMPOSER_FALLBACK_NAMES=openai/gpt-5-mini
# MODEL_PLANNER_NAME=deepseek/deepseek-v4-flash-0731
# MODEL_PLANNER_FALLBACK_NAMES=openai/gpt-5-mini
# MODEL_ASSESSOR_NAME=deepseek/deepseek-v4-flash-0731
# MODEL_ASSESSOR_FALLBACK_NAMES=openai/gpt-5-nano
# MODEL_RESPONDER_NAME=deepseek/deepseek-v4-flash-0731
# MODEL_RESPONDER_FALLBACK_NAMES=openai/gpt-5-mini
# MODEL_COMPANION_RESPONDER_NAME=openai/gpt-oss-20b:free
# MODEL_COMPANION_RESPONDER_FALLBACK_NAMES=google/gemma-4-31b-it:free,inclusionai/ling-3.0-flash:free
# MODEL_REPAIRER_NAME=deepseek/deepseek-v4-flash-0731
# MODEL_REPAIRER_FALLBACK_NAMES=
MODEL_PROVIDER=development
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_FALLBACK_NAMES=
MODEL_ROUTER_NAME=
MODEL_ROUTER_FALLBACK_NAMES=
MODEL_COMPOSER_NAME=
MODEL_COMPOSER_FALLBACK_NAMES=
MODEL_PLANNER_NAME=
MODEL_PLANNER_FALLBACK_NAMES=
MODEL_ASSESSOR_NAME=
MODEL_ASSESSOR_FALLBACK_NAMES=
MODEL_RESPONDER_NAME=
MODEL_RESPONDER_FALLBACK_NAMES=
MODEL_COMPANION_RESPONDER_NAME=openai/gpt-oss-20b:free
MODEL_COMPANION_RESPONDER_FALLBACK_NAMES=google/gemma-4-31b-it:free,inclusionai/ling-3.0-flash:free
MODEL_REPAIRER_NAME=
MODEL_REPAIRER_FALLBACK_NAMES=
MODEL_CONFIG_VERSION=2026-08-structured-composer-v4
MODEL_REQUIRE_PINNED=true
MODEL_MAX_TOKENS=1024
MODEL_COMPOSER_MAX_TOKENS=12288
# Each lossless large-document batch has a smaller structured-output ceiling.
MODEL_COMPOSER_BATCH_MAX_TOKENS=6144
MODEL_REPAIRER_MAX_TOKENS=256
# OpenRouter stays on the selected model but uses its cheapest compatible endpoint.
MODEL_PROVIDER_SORT=price
# Prefer providers whose rolling 5-minute P90 latency is below this value; 0 disables.
MODEL_PREFERRED_MAX_LATENCY_P90_SECONDS=8
MODEL_ALLOW_PROVIDER_FALLBACKS=true
MODEL_REQUIRE_PARAMETERS=true
MODEL_MAX_PROMPT_PRICE=0.3
MODEL_MAX_COMPLETION_PRICE=2.5
# File/multimodal work keeps the existing GPT model. PDF translation is a
# separate model-backed Skill budget, not a hidden Graph call.
MODEL_TRANSLATION_NAME=openai/gpt-5-mini
MODEL_TRANSLATION_MAX_TOKENS=8000
MODEL_TRANSLATION_MAX_COST_MICROS=60000
# Independent PDF batches run concurrently inside one Worker process; valid range: 1-4.
MODEL_TRANSLATION_CONCURRENCY=2
MODEL_TRANSLATION_MAX_PROMPT_PRICE=0.3
MODEL_TRANSLATION_MAX_COMPLETION_PRICE=2.5
# Optional PPT visual generation. When blank, the worker still reuses images
# from attached PDFs and safely falls back to text-only slides.
MODEL_PRESENTATION_IMAGE_NAME=
MODEL_PRESENTATION_IMAGE_MAX_COUNT=2
# Independent image requests use this bounded fan-out; valid range: 1-4.
MODEL_PRESENTATION_IMAGE_CONCURRENCY=2
MODEL_PRESENTATION_IMAGE_MAX_COST_MICROS=250000
# Skip AI image generation once this many cited topic slots use source visuals.
MODEL_PRESENTATION_SOURCE_SUFFICIENT_COUNT=4
# deny excludes providers that collect prompts for training. ZDR is stricter and optional.
MODEL_DATA_COLLECTION=deny
MODEL_ZDR_REQUIRED=false
# Keep global effort high for open-ended response work, while assigning each
# structured control role only the reasoning it needs.
MODEL_REASONING_EFFORT=high
MODEL_PLANNER_REASONING_EFFORT=high
MODEL_ROUTER_REASONING_EFFORT=low
MODEL_COMPOSER_REASONING_EFFORT=high
MODEL_ASSESSOR_REASONING_EFFORT=minimal
MODEL_FALLBACK_REASONING_EFFORT=low
MODEL_REASONING_EXCLUDE=true
MODEL_HTTP_REFERER=
MODEL_APP_TITLE="AI Companion"
MODEL_TIMEOUT=30s
# Shared deadline for all normal-role model fallbacks, not a fresh timeout per model.
MODEL_TIMEOUT_SECONDS=30
# Bound each normal-role attempt and preserve time for configured fallbacks.
MODEL_ATTEMPT_TIMEOUT_SECONDS=15
# Complex argument composition gives DeepSeek enough time for high-effort
# structured output and preserves a fallback window inside one deadline.
MODEL_COMPOSER_TIMEOUT_SECONDS=120
MODEL_COMPOSER_ATTEMPT_TIMEOUT_SECONDS=60
MODEL_MIN_FALLBACK_TIMEOUT_SECONDS=5
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN=30s
MODEL_INPUT_COST_MICROS_PER_MILLION=0
MODEL_OUTPUT_COST_MICROS_PER_MILLION=0

# Trusted Graph budgets. Request context cannot raise these ceilings.
AGENT_MAX_ACTIONS=10
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_PROMPT_TOKENS=200000
AGENT_MAX_COMPLETION_TOKENS=16000
AGENT_MAX_COST_MICROS=50000
AGENT_MAX_TOOL_RESUMES=120
AGENT_TOOL_POLL_INTERVAL_MS=500
AGENT_TOOL_POLL_MAX_INTERVAL_MS=5000
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_MAX_REPAIR_MODEL_CALLS=1
AGENT_MAX_REPAIR_COST_MICROS=1000
AGENT_MAX_REPAIR_ADDED_LATENCY_MS=15000

# Local-only certified deployment scheduler sandbox. Keep the key empty here and inject a
# dedicated value of at least 32 bytes from the shell or a secret manager when enabling the
# explicit deployment-sandbox Compose profile. A new intentional certification needs a new nonce.
OBSERVABILITY_ADAPTER_CERTIFICATION_KEY=
OBSERVABILITY_ADAPTER_CERTIFICATION_KEY_ID=
OBSERVABILITY_ADAPTER_CERTIFICATION_NONCE=local-sandbox-v1
OBSERVABILITY_ADAPTER_CERTIFICATION_TTL=3600
OBSERVABILITY_DEPLOYMENT_SCHEDULER_INTERVAL=5
OBSERVABILITY_DEPLOYMENT_SCHEDULER_MAX_FAILURES=3
OBSERVABILITY_DEPLOYMENT_SCHEDULER_PORT=9465
OBSERVABILITY_SHADOW_PROVIDER_NAME=
OBSERVABILITY_SHADOW_PROVIDER_BASE_URL=
OBSERVABILITY_SHADOW_PROVIDER_ALLOWED_HOST=
OBSERVABILITY_SHADOW_PROVIDER_INSTANCE=
OBSERVABILITY_SHADOW_PROVIDER_TOKEN=
OBSERVABILITY_SHADOW_PROVIDER_TIMEOUT=5
OBSERVABILITY_SHADOW_PROVIDER_MAX_ATTEMPTS=2
OBSERVABILITY_SHADOW_PROVIDER_RETRY_BASE=0.25
OBSERVABILITY_SHADOW_INTERVAL=30
OBSERVABILITY_SHADOW_LIMIT=100
OBSERVABILITY_SHADOW_MAX_FAILURES=3
OBSERVABILITY_SHADOW_PORT=9466
OBSERVABILITY_SHADOW_PROVIDER_INSTANCE_SHA256=
OBSERVABILITY_DIRECT_TRAFFIC_SHADOW_PROVIDER_TOKEN=
OBSERVABILITY_DIRECT_TRAFFIC_SHADOW_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_SHADOW_GATE_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PREPRODUCTION_TOKEN=
# Dedicated secret used only to attest drill evidence; do not reuse rollout or Provider keys.
OBSERVABILITY_DIRECT_TRAFFIC_PREPRODUCTION_DRILL_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PREPRODUCTION_DRILL_KEY_ID=
# Production direct-traffic credentials are independent across all five roles and from preproduction.
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_TOKEN=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_ROLLOUT_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_ROLLOUT_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_CERTIFICATION_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_CERTIFICATION_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_SHADOW_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_SHADOW_GATE_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_GATE_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EMERGENCY_TOKEN=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EMERGENCY_ROLLOUT_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EMERGENCY_ROLLOUT_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EMERGENCY_CERTIFICATION_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EMERGENCY_CERTIFICATION_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EMERGENCY_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EMERGENCY_GATE_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_TOKEN=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_ROLLOUT_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_ROLLOUT_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_CERTIFICATION_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_CERTIFICATION_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_SHADOW_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_SHADOW_GATE_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_RECOVERY_GATE_KEY_ID=
# The 5%-to-10% stage has another fully isolated Provider/proof trust domain.
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_TOKEN=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_ROLLOUT_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_ROLLOUT_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_CERTIFICATION_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_CERTIFICATION_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_SHADOW_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_SHADOW_GATE_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_GATE_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_GATE_KEY_ID=
# The 10%-to-25% stage is isolated from the 5%-to-10% credentials.
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_25_TOKEN=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_25_ROLLOUT_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_25_ROLLOUT_KEY_ID=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_25_CERTIFICATION_KEY=
OBSERVABILITY_DIRECT_TRAFFIC_PRODUCTION_EXPANSION_25_CERTIFICATION_KEY_ID=
